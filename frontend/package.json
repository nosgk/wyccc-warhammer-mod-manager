{
  "name": "wyccc-mod-manager-frontend",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write \"src/components/ModOrderAnalysisModal.vue\" \"src/modOrderLanguages.js\" \"src/__tests__/modOrderAnalysis.test.js\"",
    "format:check": "prettier --check \"src/components/ModOrderAnalysisModal.vue\" \"src/modOrderLanguages.js\" \"src/__tests__/modOrderAnalysis.test.js\"",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@11.7.0"
}
